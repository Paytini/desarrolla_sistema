# Copia a load-testing/.env.app y arranca la app con scripts/start-target.sh
# DATABASE_URL/DIRECT_URL: los mismos del .env raiz (los datos van namespaced)
PORT=3005
NEXTAUTH_URL="http://localhost:3005"
AUTH_TRUST_HOST="true"
# Turnstile: claves de PRUEBA oficiales de Cloudflare (siempre pasan)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Bridge: SIEMPRE el mock durante cargas
WP_BRIDGE_BASE_URL="http://localhost:4380/wp-json/desarrolla360/v1"
WP_BRIDGE_PORTAL_KEY="lt-mock-bridge-key"
NEXT_PUBLIC_WORDPRESS_SITE_URL="http://localhost:4380"
# Secretos de sync/webhook para el entorno de prueba
BRIDGE_WEBHOOK_SECRET="lt-webhook-secret"
CRON_SECRET="lt-cron-secret"
# SES sin credenciales: los envios fallan y se tragan (notifications.ts) — aceptable en carga
