# Pooler de Supabase (puerto 6543) — usado por la app en runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Conexión directa de Supabase (puerto 5432) — usada por prisma migrate / prisma.config.ts
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DATABASE_POOL_MAX="5"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
PORTAL_TIME_ZONE="America/Tijuana"
NEXT_PUBLIC_PORTAL_TIME_ZONE="America/Tijuana"

WP_BRIDGE_BASE_URL="https://tu-dominio.com/wp-json/desarrolla360/v1"
WP_BRIDGE_PORTAL_KEY="replace-with-your-shared-key"
NEXT_PUBLIC_WORDPRESS_SITE_URL="https://tu-dominio.com"
NEXT_PUBLIC_EXCALIDRAW_DIAGRAM_URL="https://excalidraw.com/#json=FDdX2opcSKwzivfCi0ezE,kWle84XXg3YZurxf1o9frA"

CRON_SECRET="replace-with-a-cron-secret"
BACKGROUND_SYNC_SECRET="replace-with-a-background-sync-secret"
EMPLOYEE_SYNC_INTERVAL_MS="15000"
BRIDGE_WEBHOOK_SECRET="replace-with-a-webhook-secret"

TUTORLMS_API_KEY="replace-with-your-tutor-api-key"
TUTORLMS_SECRET="replace-with-your-tutor-api-secret"

# Vercel Blob — almacenamiento de logos y firmas (Vercel lo inyecta en prod)
BLOB_READ_WRITE_TOKEN="replace-with-your-vercel-blob-rw-token"

# Cloudflare Turnstile — captcha del login
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-your-turnstile-site-key"
TURNSTILE_SECRET_KEY="replace-with-your-turnstile-secret-key"

# Amazon SES — envío de correos (credenciales, etc.)
AWS_ACCESS_KEY_ID="replace-with-your-ses-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-your-ses-secret-access-key"
AWS_REGION="us-east-1"
SES_FROM_EMAIL="replace-with-your-verified-sender@tu-dominio.com"
CONSULTING_NOTIFICATION_EMAIL="replace-with-your-consulting-team-inbox@tu-dominio.com"
EMAIL_SENDING_ENABLED="false"
