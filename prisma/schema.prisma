// ─────────────────────────────────────────────────────────────
//  Desarrolla360 — Business Portal
//  Database: PostgreSQL
//  ORM: Prisma
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN // Desarrolla360 — full access
  HR // Company HR admin — manages their own employees
  EMPLOYEE // Worker — sees their own courses
}

enum ConsultingArea {
  CTPAT // Seguridad en la cadena de suministro
  OEA // Operador Económico Autorizado
  FIRE_SAFETY // Sistemas Contra Incendios
  HUMAN_RESOURCES // Recursos Humanos
  EC0217 // Impartición de cursos de formación del capital humano
  EC0634 // Auditoría de la seguridad en la cadena de suministro
  EC0306 // Reclutamiento y Selección de Personal Operativo y Administración
  EC0397_01 // Vigilancia del cumplimiento de la normatividad en seguridad y salud en el trabajo

  // Retired from the selectable catalog (lib/consulting-areas.ts) but kept in the
  // enum — existing consulting_requests rows still reference these and Postgres
  // enum values can't be dropped without recreating the type.
  LOGISTICS
  MANUFACTURING
  INDUSTRIAL_SAFETY
  ISO_STANDARDS
  CONOCER_CERT
}

enum ConsultingContactMethod {
  CALL
  WHATSAPP
  EMAIL
}

enum ConsultingRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
//  USER
//  Handles portal login for all three roles.
//  Employees also have a user record here (role EMPLOYEE).
//  wp_user_id links to WordPress when applicable.
// ─────────────────────────────────────────────────────────────

model User {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                        String    @unique
  password_hash                String
  role                         Role
  name                         String
  company_id                   String?   @db.Uuid // null for SUPERADMIN
  wp_user_id                   Int? // WordPress user ID (nullable)
  active                       Boolean   @default(true)
  last_access                  DateTime?
  activation_token             String?   @unique
  activation_token_expires_at  DateTime?
  must_change_password         Boolean   @default(false)
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt

  company            Company?            @relation(fields: [company_id], references: [id])
  sessions           PortalSession[]
  notifications      Notification[]
  consultingRequests ConsultingRequest[]

  @@index([company_id])
  @@index([role, active])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
//  NOTIFICATION
//  Notifications directed at a user (today: SuperAdmin),
//  generated when relevant system events occur.
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  type        String
  title       String
  message     String
  read        Boolean  @default(false)
  archived    Boolean  @default(false)
  entity_type String?
  entity_id   String?  @db.Uuid
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, read])
  @@index([user_id, archived])
  @@index([created_at])
  @@index([type, entity_id])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
//  COMPANY
//  Each client that purchased a course package.
//  contracted_seats: set by the SuperAdmin when creating the company.
//  used_seats: updated automatically as employees are added/removed.
// ─────────────────────────────────────────────────────────────

model Company {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String   @unique // used in portal URLs, e.g. /company/acme
  logo_url         String? // company-branded logo shown in the portal
  hr_email         String   @unique // HR contact's email
  phone            String?
  rfc              String? // Mexican tax ID
  contracted_seats Int // maximum employees allowed
  used_seats       Int      @default(0)
  active           Boolean  @default(true)
  notes            String?  @db.Text // internal Desarrolla360 notes
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  users              User[]
  employees          Employee[]
  packages           CompanyPackage[]
  consultingRequests ConsultingRequest[]

  @@map("companies")
}

// ─────────────────────────────────────────────────────────────
//  PACKAGE
//  Catalog of course packages Desarrolla360 offers.
//  The courses within each package are stored in PackageCourse.
// ─────────────────────────────────────────────────────────────

model Package {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String // "Basic CTPAT", "Supply Chain", etc.
  description       String?  @db.Text
  delivery_mode     String   @default("DIRECT_ENROLLMENT") // DIRECT_ENROLLMENT | PRIVATE_BUNDLE_REFERENCE
  wp_bundle_id      Int? // optional: private bundle in Tutor LMS for academic organization
  bundle_name       String? // cached name of the private bundle
  operational_notes String?  @db.Text
  active            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  courses   PackageCourse[]
  companies CompanyPackage[]

  @@map("packages")
}

// ─────────────────────────────────────────────────────────────
//  PACKAGE_COURSE
//  Which Tutor LMS courses each package includes.
//  wp_course_id: the course's ID in WordPress/Tutor LMS.
// ─────────────────────────────────────────────────────────────

model PackageCourse {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  package_id   String  @db.Uuid
  wp_course_id Int // course ID in Tutor LMS Pro
  course_name  String // cached name so we don't always query WP
  cover_url    String? // URL of the course's featured image in WordPress
  description  String? @db.Text
  lesson_count Int?

  package Package @relation(fields: [package_id], references: [id])

  @@unique([package_id, wp_course_id])
  @@index([package_id])
  @@index([wp_course_id])
  @@map("package_courses")
}

// ─────────────────────────────────────────────────────────────
//  COURSE_DC3_METADATA
//  Official DC-3 record per Tutor LMS course.
//  Cached in the portal to generate certificates with controlled
//  data, without depending on querying WordPress live.
// ─────────────────────────────────────────────────────────────

model CourseDc3Metadata {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wp_course_id                Int       @unique
  course_name                 String?
  duration_hours              Float?
  subject_area_name           String?
  subject_area_code           String?
  training_agent_name         String?
  training_agent_registration String?
  instructor_name             String?
  instructor_signature_url    String?
  source                      String    @default("MANUAL") // MANUAL | WORDPRESS_BRIDGE
  last_synced_at              DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  @@index([wp_course_id])
  @@map("course_dc3_metadata")
}

// ─────────────────────────────────────────────────────────────
//  COMPANY_PACKAGE
//  Relationship between a company and the package it contracted.
//  Includes dates to handle expirations and renewals.
// ─────────────────────────────────────────────────────────────

model CompanyPackage {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String    @db.Uuid
  package_id      String    @db.Uuid
  start_date      DateTime  @default(now())
  expiration_date DateTime? // null = no expiration
  active          Boolean   @default(true)
  created_at      DateTime  @default(now())

  company Company @relation(fields: [company_id], references: [id])
  package Package @relation(fields: [package_id], references: [id])

  @@index([company_id, active, created_at])
  @@index([expiration_date])
  @@map("company_packages")
}

// ─────────────────────────────────────────────────────────────
//  CONSULTING_REQUEST
//  A live consulting session an HR user booked from the portal.
//  Reviewed manually by the consulting team — status starts PENDING
//  and is updated outside the portal for now (no UI to change it yet).
// ─────────────────────────────────────────────────────────────

model ConsultingRequest {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id           String                  @db.Uuid
  requested_by_user_id String                  @db.Uuid
  area                 ConsultingArea
  context              String                  @db.Text
  preferred_date       DateTime                @db.Date
  preferred_time       String // "10:00", 24h, wall-clock time in `timezone`
  timezone             String                  @default("America/Tijuana")
  contact_phone        String
  contact_method       ConsultingContactMethod
  status               ConsultingRequestStatus @default(PENDING)
  created_at           DateTime                @default(now())

  company     Company @relation(fields: [company_id], references: [id])
  requestedBy User    @relation(fields: [requested_by_user_id], references: [id])

  @@index([company_id])
  @@map("consulting_requests")
}

// ─────────────────────────────────────────────────────────────
//  EMPLOYEE
//  Registered by the company's HR team.
//  wp_user_id: filled in once the employee exists in WordPress
//  or once their WP user is created to access Tutor LMS.
// ─────────────────────────────────────────────────────────────

model Employee {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id       String   @db.Uuid
  wp_user_id       Int?     @unique // WordPress ID, unique once linked
  first_name       String
  last_name        String
  second_last_name String?
  email            String   @unique
  curp             String? // Mexican personal ID
  department       String?
  position         String?
  occupation_code  String?
  occupation_name  String?
  active           Boolean  @default(true)
  sync_lock_until  DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  company           Company            @relation(fields: [company_id], references: [id])
  courses           EmployeeCourse[]
  certificates      Certificate[]
  quizAttempts      QuizAttempt[]
  lessonCompletions LessonCompletion[]

  @@index([company_id, active])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────
//  EMPLOYEE_COURSE
//  Each employee's progress in each course.
//  Data comes from the Tutor LMS REST API and is cached here
//  so we don't query WordPress on every page load.
//  last_synced_at: when it was last refreshed from WP.
// ─────────────────────────────────────────────────────────────

model EmployeeCourse {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id         String    @db.Uuid
  wp_course_id        Int // course ID in Tutor LMS
  course_name         String // cached from WP
  progress_pct        Int       @default(0) // 0–100
  completed           Boolean   @default(false)
  access_status       String    @default("PENDING") // PENDING | ACTIVE | ERROR | REQUIRES_REVIEW
  access_source       String? // DIRECT_ENROLLMENT | PRIVATE_BUNDLE_REFERENCE
  access_error        String?   @db.Text
  last_access_attempt DateTime?
  course_start_date   DateTime?
  completed_at        DateTime?
  last_synced_at      DateTime  @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, wp_course_id])
  @@index([employee_id, last_synced_at])
  @@index([last_synced_at])
  @@index([access_status])
  @@index([completed])
  @@map("employee_courses")
}

model QuizAttempt {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id               String    @db.Uuid
  wp_course_id              Int
  wp_quiz_id                Int
  wp_attempt_id             Int       @unique
  quiz_name                 String?
  total_questions           Int       @default(0)
  total_answered_questions  Int       @default(0)
  total_marks               Float     @default(0)
  earned_marks              Float     @default(0)
  attempt_status            String?
  result                    String? // pass | fail | pending (Tutor LMS's own values)
  attempt_started_at        DateTime?
  attempt_ended_at          DateTime?
  last_synced_at            DateTime  @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
  @@index([employee_id, wp_course_id])
  @@map("quiz_attempts")
}

model LessonCompletion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id    String    @db.Uuid
  wp_course_id   Int
  wp_lesson_id   Int
  lesson_name    String?
  completed_at   DateTime?
  last_synced_at DateTime  @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, wp_lesson_id])
  @@index([employee_id])
  @@index([employee_id, wp_course_id])
  @@map("lesson_completions")
}

// ─────────────────────────────────────────────────────────────
//  CERTIFICATE
//  Record of each certificate an employee earned.
//  reference_number: generated by the portal (e.g. D360-2025-0312-001).
//  certificate_url: link to the PDF generated by Tutor LMS Pro.
// ─────────────────────────────────────────────────────────────

model Certificate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String   @db.Uuid
  wp_course_id     Int
  course_name      String
  reference_number String   @unique // D360-YYYY-MMDD-{folioSequence:6-digit}-{wp_course_id}
  certificate_url  String? // URL of the PDF in WordPress
  dc3_pdf_url      String? // URL of the portal-generated DC-3 PDF, cached in Vercel Blob
  folio_sequence   Int      @default(autoincrement()) // short readable sequence for the official DC-3 folio, decoupled from id
  issued_at        DateTime @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
  @@index([wp_course_id])
  @@map("certificates")
}

model IntegrationState {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String   @unique
  payload    Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("integration_states")
}

// ─────────────────────────────────────────────────────────────
//  PORTAL_SESSION
//  Active portal session tokens.
//  NextAuth manages these automatically, but this table lets
//  SuperAdmin revoke access from the admin panel.
// ─────────────────────────────────────────────────────────────

model PortalSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique @db.VarChar(512)
  expires_at DateTime
  ip_address String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("portal_sessions")
}

// ─────────────────────────────────────────────────────────────
//  AUDIT_EVENT
//  Log of relevant administrative actions
//  (company creation, package assignment, suspensions, etc.).
// ─────────────────────────────────────────────────────────────

model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?  @db.Uuid
  actor_name    String
  actor_email   String?
  actor_role    String
  action        String
  entity_type   String
  entity_id     String?  @db.Uuid
  company_id    String?  @db.Uuid
  summary       String
  metadata      Json?
  created_at    DateTime @default(now())

  @@index([created_at])
  @@index([company_id])
  @@index([action])
  @@map("audit_events")
}

// ─────────────────────────────────────────────────────────────
//  SEAT_HISTORY
//  Historical record of seat changes per company.
//  Used for traceability of contracted vs. used capacity.
// ─────────────────────────────────────────────────────────────

model SeatHistory {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id              String   @db.Uuid
  actor_user_id           String?  @db.Uuid
  actor_name              String
  actor_email             String?
  actor_role              String
  reason                  String
  detail                  String?  @db.Text
  contracted_seats_before Int
  contracted_seats_after  Int
  used_seats_before       Int
  used_seats_after        Int
  suspended_employees     Int      @default(0)
  created_at              DateTime @default(now())

  @@index([company_id])
  @@index([created_at])
  @@map("seat_history")
}

// ─────────────────────────────────────────────────────────────
//  JOB
//  Generic async job queue. A Vercel Cron (see vercel.json) picks up
//  PENDING jobs and processes them in bounded chunks so no single
//  invocation runs unbounded (see G-2 in docs-observability/INFORME-RENDIMIENTO.md).
// ─────────────────────────────────────────────────────────────

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

model Job {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String
  status          JobStatus @default(PENDING)
  payload         Json
  result          Json?
  error           String?   @db.Text
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  started_at      DateTime?
  completed_at    DateTime?
  next_attempt_at DateTime?

  @@index([status, type])
  @@map("jobs")
}
